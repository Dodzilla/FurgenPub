# Reuse the verified native build; no rental-time compilation or model weights.
FROM ghcr.io/dodzilla/furgen-vast-v7@sha256:6be7200c7b53fe79f4d3b5b09dd5f86372a4e2d25c4891b08cc7806db7c7f5d2 AS slim
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
COPY remove-obsolete-cuda.py /opt/furgen/v7/remove-obsolete-cuda.py
COPY remove-stock-model.py /opt/furgen/v7/remove-stock-model.py
RUN /venv/main/bin/python /opt/furgen/v7/remove-stock-model.py
RUN /venv/main/bin/python /opt/furgen/v7/remove-obsolete-cuda.py --manifest /opt/furgen/v7/manifest.json && \
    /venv/main/bin/python -c 'import torch; assert torch.version.cuda == "13.0"; print(torch.ones(1))'
RUN mapfile -t obsolete < <(dpkg-query -W -f='${Package}\n' | grep -E '(-12-9$|^libcublas-dev-13-0$|^cuda-nvcc-13-0$|^cuda-cccl-13-0$|^libnvvm-13-0$|^libnvptxcompiler-13-0$)') && \
    apt-mark manual cuda-cudart-13-0 libcublas-13-0 && apt-get purge -y "${obsolete[@]}" && apt-get clean && \
    /venv/main/bin/python -c 'import torch, torchvision, torchaudio, transformers; assert torch.version.cuda == "13.0"' && \
    ldd /opt/furgen/v7/llama-build/bin/llama-server > /tmp/llama-linkage.txt && \
    ! grep 'not found' /tmp/llama-linkage.txt | grep -v 'libcuda.so.1' && \
    /venv/main/bin/python /opt/furgen/v7/asset_gen_v7_lite_prebuilt.py verify --comfy /opt/workspace-internal/ComfyUI
RUN du -xhd1 /opt && du -xhd1 /usr/local && du -xhd1 /venv/main/lib/python3.12/site-packages | sort -h | tail -n 20

FROM scratch
COPY --from=slim / /
SHELL ["/bin/bash","-o","pipefail","-c"]
ENV PATH="/opt/instance-tools/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ENV IMAGE_TYPE="vast"
ENV DATA_DIRECTORY="/workspace"
ENV WORKSPACE="/workspace"
ENV PIP_BREAK_SYSTEM_PACKAGES="1"
ENV DEBIAN_FRONTEND="noninteractive"
ENV PYTHONUNBUFFERED="1"
ENV TCLLIBPATH="/usr/lib/tcltk/default"
ENV NVIDIA_DRIVER_CAPABILITIES="all"
ENV UV_CACHE_DIR="/.uv/cache"
ENV UV_NO_CACHE="1"
ENV UV_LINK_MODE="copy"
ENV UV_PYTHON_BIN_DIR="/.uv/python_bin"
ENV UV_PYTHON_INSTALL_DIR="/.uv/python_install"
ENV PYTHON_VERSION="3.12"
ENV PYTORCH_VERSION="2.10.0"
ENV PYTORCH_BACKEND="cu130"
ENV COMFYUI_ARGS="--disable-auto-launch --enable-cors-header --port 18188"
ENV FURGEN_CUDA_VERSION="13.0"
ENV FURGEN_REQUIRE_PREBUILT_V7="true"
RUN /venv/main/bin/python /opt/furgen/v7/asset_gen_v7_lite_prebuilt.py verify --comfy /opt/workspace-internal/ComfyUI
ENTRYPOINT ["/opt/instance-tools/bin/entrypoint.sh"]

LABEL org.opencontainers.image.source="https://github.com/Dodzilla/FurgenPub"
RUN env-hash > /.env_hash && sha256sum /opt/furgen/v7/manifest.json
